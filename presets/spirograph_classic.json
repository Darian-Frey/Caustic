          "cyclic": true
        },
        "transform": {
          "translate": [0.0, 0.0],
          "rotate_rad": 0.0,
          "scale": 1.0,
          "mirror_x": false,
          "mirror_y": false
        },
        "visible": true
      }
    ]
  },
  "camera": { "pan_x_px": 0.0, "pan_y_px": 0.0, "zoom": 1.0 }
}
